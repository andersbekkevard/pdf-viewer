[
    {
        "id": 1,
        "priority": 2,
        "action": {
            "type": "allow"
        },
        "condition": {
            "urlFilter": "_pdfvw=passthrough",
            "resourceTypes": [
                "main_frame"
            ]
        }
    },
    {
        "id": 2,
        "priority": 1,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                { "header": "content-type", "operation": "set", "value": "text/plain; charset=utf-8" },
                { "header": "x-content-type-options", "operation": "set", "value": "nosniff" },
                { "header": "server-timing", "operation": "set", "value": "pdfv" },
                { "header": "content-disposition", "operation": "remove" },
                { "header": "content-security-policy", "operation": "remove" },
                { "header": "content-security-policy-report-only", "operation": "remove" },
                { "header": "cross-origin-embedder-policy", "operation": "remove" },
                { "header": "permissions-policy", "operation": "remove" },
                { "header": "refresh", "operation": "remove" }
            ]
        },
        "condition": {
            "regexFilter": "^https?://.*",
            "resourceTypes": [
                "main_frame"
            ],
            "requestMethods": [
                "get"
            ],
            "excludedRequestDomains": [
                "localhost",
                "127.0.0.1"
            ],
            "responseHeaders": [
                {
                    "header": "content-type",
                    "values": [
                        "application/pdf*",
                        "application/x-pdf*"
                    ]
                }
            ],
            "excludedResponseHeaders": [
                {
                    "header": "content-disposition",
                    "values": [
                        "attachment*"
                    ]
                }
            ]
        }
    },
    {
        "id": 3,
        "priority": 1,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                { "header": "content-type", "operation": "set", "value": "text/plain; charset=utf-8" },
                { "header": "x-content-type-options", "operation": "set", "value": "nosniff" },
                { "header": "server-timing", "operation": "set", "value": "pdfv" },
                { "header": "content-disposition", "operation": "remove" },
                { "header": "content-security-policy", "operation": "remove" },
                { "header": "content-security-policy-report-only", "operation": "remove" },
                { "header": "cross-origin-embedder-policy", "operation": "remove" },
                { "header": "permissions-policy", "operation": "remove" },
                { "header": "refresh", "operation": "remove" }
            ]
        },
        "condition": {
            "regexFilter": "^https?://[^?#]*\\.[Pp][Dd][Ff](?:[?#].*)?$",
            "resourceTypes": [
                "main_frame"
            ],
            "requestMethods": [
                "get"
            ],
            "excludedRequestDomains": [
                "localhost",
                "127.0.0.1"
            ],
            "responseHeaders": [
                {
                    "header": "content-type",
                    "values": [
                        "application/octet-stream*",
                        "binary/octet-stream*"
                    ]
                }
            ],
            "excludedResponseHeaders": [
                {
                    "header": "content-disposition",
                    "values": [
                        "attachment*"
                    ]
                }
            ]
        }
    }
]
