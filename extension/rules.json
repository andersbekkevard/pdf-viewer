[
    {
        "id": 1,
        "priority": 2,
        "action": {
            "type": "allow"
        },
        "condition": {
            "urlFilter": "_pdfvw=passthrough",
            "resourceTypes": [
                "main_frame"
            ]
        }
    },
    {
        "id": 2,
        "priority": 1,
        "action": {
            "type": "redirect",
            "redirect": {
                "regexSubstitution": "http://localhost:7435/view-raw?\\0"
            }
        },
        "condition": {
            "regexFilter": "^https?://.*\\.[Pp][Dd][Ff](?:\\?.*)?$",
            "resourceTypes": [
                "main_frame"
            ],
            "excludedRequestDomains": [
                "localhost",
                "127.0.0.1"
            ]
        }
    },
    {
        "id": 3,
        "priority": 1,
        "action": {
            "type": "redirect",
            "redirect": {
                "regexSubstitution": "http://localhost:7435/view-raw?\\0"
            }
        },
        "condition": {
            "regexFilter": "^https?://.*",
            "resourceTypes": [
                "main_frame"
            ],
            "requestMethods": [
                "get"
            ],
            "excludedRequestDomains": [
                "localhost",
                "127.0.0.1"
            ],
            "responseHeaders": [
                {
                    "header": "content-type",
                    "values": [
                        "application/pdf*"
                    ]
                }
            ],
            "excludedResponseHeaders": [
                {
                    "header": "content-disposition",
                    "values": [
                        "attachment*"
                    ]
                }
            ]
        }
    }
]
