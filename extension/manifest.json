{
    "manifest_version": 3,
    "key": "",
    "name": "Anders PDF Viewer",
    "version": "0.5.0",
    "description": "Read PDFs in the pdf_viewer reader at their own address: web PDFs by response type, local files, and cached documents.",
    "permissions": [
        "declarativeNetRequestWithHostAccess",
        "webRequest",
        "alarms",
        "storage"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*",
        "file:///*"
    ],
    "action": {
        "default_title": "Toggle pdf_viewer for this PDF",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*",
                "file:///*"
            ],
            "js": [
                "page.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "bridge.html",
                "assets/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "pdf_redirect",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    }
}
